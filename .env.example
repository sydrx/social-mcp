# social-mcp example configuration
#
# Copy this file to `.env` in the same folder and fill in the real values:
#     Copy-Item .env.example .env
#
# `.env` is listed in .gitignore and must never be committed.
# The .env file is read by config.py on startup; server.py refuses to
# start without TELEGRAM_API_ID and TELEGRAM_API_HASH.


# --- REQUIRED -------------------------------------------------------------

# Numeric "App api_id" from https://my.telegram.org -> API Development Tools.
# A plain number, e.g. 1234567. No quotes needed.
TELEGRAM_API_ID=

# 32-character hexadecimal "App api_hash" from the same page.
# Keep the quotes: it is a string that may look like a number.
TELEGRAM_API_HASH=


# --- Only needed for the first interactive login -------------------------

# Your phone number in international format. Only read by setup_auth.py,
# the MCP server itself never needs it.
# TELEGRAM_PHONE=+79991234567


# --- Optional overrides ---------------------------------------------------

# Where the .session file and state.sqlite3 live.
# Default: %USERPROFILE%\.social-mcp
# SOCIAL_MCP_DATA_DIR=C:\Users\yourname\.social-mcp

# Path to the authorized Telethon session. Default is telegram.session
# inside SOCIAL_MCP_DATA_DIR. Only override if you keep sessions elsewhere.
# TELEGRAM_SESSION_PATH=C:\Users\yourname\.social-mcp\telegram.session

# SQLite file for bookkeeping. Defaults to state.sqlite3 in the data dir.
# SOCIAL_MCP_DB_PATH=C:\Users\yourname\.social-mcp\state.sqlite3

# DEBUG prints Telegram API traffic to stderr. stdio is unaffected because
# logs go to stderr, but it is very noisy.
# SOCIAL_MCP_LOG_LEVEL=INFO


# --- First-time setup, run once from a normal terminal --------------------

# .\.venv\Scripts\python.exe setup_auth.py --telegram
#
# opencode launches server.py over stdio and cannot answer prompts, so the
# initial login has to happen here. Afterwards the .session file is reused
# and no further login is needed.
